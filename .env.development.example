# =========================================================================
# VARANASI YATRA TRAVEL OS — DEVELOPMENT ENVIRONMENT CONFIGURATION
# =========================================================================

# APPLICATION
NODE_ENV=development
PORT=5001
API_BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AUTH
JWT_SECRET=development_jwt_access_secret_key_min_32_chars
JWT_REFRESH_SECRET=development_jwt_refresh_secret_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# DATABASE
MONGODB_URI=mongodb://localhost:27017/varanasi_yatra_dev

# AUTOMATION
AUTOMATION_ENABLED=true
NOTIFICATION_PROVIDER=ConsoleProvider

# WHATSAPP (MOCK FOR DEV)
META_WHATSAPP_ACCESS_TOKEN=mock_wa_access_token
META_WHATSAPP_PHONE_NUMBER_ID=mock_phone_number_id

# EMAIL (MOCK / SMTP FOR DEV)
EMAIL_PROVIDER=ConsoleProvider
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_smtp_user
SMTP_PASSWORD=mock_smtp_password
EMAIL_FROM=noreply@varanasiyatra.com

# DOCUMENT STORAGE
STORAGE_PROVIDER=LocalStorageProvider
STORAGE_LOCAL_PATH=./uploads/documents

# OPTIONAL CLOUD STORAGE
CLOUD_STORAGE_BUCKET=varanasi-yatra-dev-bucket
CLOUD_STORAGE_REGION=ap-south-1
CLOUD_STORAGE_ACCESS_KEY=mock_access_key
CLOUD_STORAGE_SECRET_KEY=mock_secret_key

# LOGGING
LOG_LEVEL=debug
