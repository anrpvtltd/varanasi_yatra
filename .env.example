# =========================================================================
# VARANASI YATRA TRAVEL OS — ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================

# 1. APPLICATION & RUNTIME
NODE_ENV=development
PORT=5001
API_BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173

# 2. CORS ALLOWED ORIGINS (COMMA-SEPARATED)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://varanasi-yatra.vercel.app

# 3. SECURITY & AUTHENTICATION (MINIMUM 32 CHARACTERS IN PRODUCTION)
JWT_SECRET=your_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 4. DATABASE CONFIGURATION (MongoDB Atlas / Local)
MONGODB_URI=mongodb://localhost:27017/varanasi_yatra
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2

# 5. AUTOMATION & NOTIFICATION PROVIDERS
AUTOMATION_ENABLED=true
NOTIFICATION_PROVIDER=ConsoleProvider
# In Development/Test: ConsoleProvider (logs notifications to console)
# In Staging/Production: ProductionProvider / Meta WhatsApp & SMTP

# Meta WhatsApp Cloud API (Optional in Dev/Test)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# Email SMTP Credentials (Optional in Dev/Test)
EMAIL_PROVIDER=SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=support@varanasiyatra.com

# 6. STORAGE & FILE ATTACHMENTS
STORAGE_PROVIDER=LocalStorageProvider
# Options: LocalStorageProvider | CloudStorageProvider
STORAGE_LOCAL_PATH=./uploads/attachments
MAX_FILE_SIZE_MB=10

# Cloud Storage Configuration (Required only if STORAGE_PROVIDER=CloudStorageProvider)
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_REGION=ap-south-1
CLOUD_STORAGE_ACCESS_KEY=
CLOUD_STORAGE_SECRET_KEY=

# 7. LOGGING & OBSERVABILITY
LOG_LEVEL=info
