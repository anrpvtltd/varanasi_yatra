# =========================================================================
# VARANASI YATRA TRAVEL OS — STAGING ENVIRONMENT CONFIGURATION
# =========================================================================

# 1. APPLICATION & RUNTIME
NODE_ENV=staging
PORT=5001
API_BASE_URL=https://staging-api.varanasiyatra.com
FRONTEND_URL=https://staging.varanasiyatra.com

# 2. CORS ALLOWED ORIGINS (COMMA-SEPARATED STAGING DOMAINS)
ALLOWED_ORIGINS=https://staging.varanasiyatra.com,https://varanasi-yatra.vercel.app,http://localhost:5173

# 3. SECURITY & AUTHENTICATION (MINIMUM 32 CHARACTERS IN STAGING & PRODUCTION)
JWT_SECRET=staging_super_secure_jwt_access_secret_key_minimum_32_characters
JWT_REFRESH_SECRET=staging_super_secure_jwt_refresh_secret_key_minimum_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 4. DATABASE (MANAGED MONGODB ATLAS STAGING CLUSTER)
MONGODB_URI=mongodb+srv://staging_user:staging_password@staging-cluster.mongodb.net/varanasi_yatra_staging?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2

# 5. AUTOMATION & NOTIFICATION PROVIDERS
AUTOMATION_ENABLED=true
NOTIFICATION_PROVIDER=ConsoleProvider
# Staging can use ConsoleProvider (safe sandbox) or staging Meta/SMTP accounts

# Optional Staging WhatsApp (Meta Cloud API Sandbox)
META_WHATSAPP_ACCESS_TOKEN=EAAG_STAGING_TOKEN_PLACEHOLDER
META_WHATSAPP_PHONE_NUMBER_ID=100111222333444

# Optional Staging Email (Mailtrap / SendGrid Staging Sandbox)
EMAIL_PROVIDER=SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=staging_smtp_user_placeholder
SMTP_PASSWORD=staging_smtp_password_placeholder
EMAIL_FROM=staging@varanasiyatra.com

# 6. DOCUMENT STORAGE
STORAGE_PROVIDER=LocalStorageProvider
# Options: LocalStorageProvider | CloudStorageProvider
STORAGE_LOCAL_PATH=./uploads/attachments
MAX_FILE_SIZE_MB=10

# Optional Staging Cloud Storage Bucket
CLOUD_STORAGE_BUCKET=varanasi-yatra-staging-documents
CLOUD_STORAGE_REGION=ap-south-1

# 7. LOGGING & OBSERVABILITY
LOG_LEVEL=info
