# =========================================================================
# VARANASI YATRA TRAVEL OS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================
# Atlas Project: Kashi-Vashi Production
# Cluster: kashi-vashi-prod
# Database: kashiVashiDB_prod
# Database User: kashivashi_app
#
# IMPORTANT:
# 1. Never commit real passwords, secrets, or active tokens to Git.
# 2. Inject these environment variables directly into Cloud Run and Vercel.
# 3. Replace <db_password>, <jwt_secret>, etc. with generated secrets.
# =========================================================================

# -------------------------------------------------------------------------
# 1. BACKEND RUNTIME SETTINGS
# -------------------------------------------------------------------------
NODE_ENV=production
PORT=5001
LOG_LEVEL=info

# -------------------------------------------------------------------------
# 2. PRODUCTION DATABASE (Atlas Project: Kashi-Vashi Production)
# -------------------------------------------------------------------------
# Cluster: kashi-vashi-prod | Database: kashiVashiDB_prod | User: kashivashi_app
MONGODB_URI=mongodb+srv://kashivashi_app:<db_password>@kashi-vashi-prod.omlaknp.mongodb.net/kashiVashiDB_prod?appName=kashi-vashi-prod
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2

# -------------------------------------------------------------------------
# 3. CORS ALLOWED ORIGINS (Must support official domain & Vercel deployment)
# -------------------------------------------------------------------------
ALLOWED_ORIGINS=https://varanasiyatra.com,https://www.varanasiyatra.com,https://admin.varanasiyatra.com,https://varanasi-yatra.vercel.app

# -------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION SECRETS (Required >= 32 characters in prod)
# -------------------------------------------------------------------------
JWT_SECRET=<generate_32_plus_char_random_jwt_access_secret>
JWT_REFRESH_SECRET=<generate_32_plus_char_random_jwt_refresh_secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -------------------------------------------------------------------------
# 5. MANDATORY INITIAL PASSWORDS (Required in production, no fallbacks)
# -------------------------------------------------------------------------
CEO_EMAIL=ceo@banarasyatra.com
CEO_INITIAL_PASSWORD=<strong_random_ceo_initial_password>
MANAGER_EMAIL=manager@banarasyatra.com
MANAGER_INITIAL_PASSWORD=<strong_random_manager_initial_password>

# -------------------------------------------------------------------------
# 6. OPTIONAL EXTERNAL INTEGRATIONS (Configure when live)
# -------------------------------------------------------------------------
# Email SMTP (Declared SMTP_NOT_CONFIGURED when unset)
EMAIL_USER=
EMAIL_PASS=

# AI Search APIs (Advisory Hunter)
HUNTER_SEARCH_API_KEY=
SERP_API_KEY=

# -------------------------------------------------------------------------
# 7. FRONTEND BUILD VARIABLES (Inject into Vercel Project Settings)
# -------------------------------------------------------------------------
# VITE_API_BASE_URL points to the Google Cloud Run API instance or custom domain
VITE_API_BASE_URL=https://api-gzo7qrxiuq-uc.a.run.app
