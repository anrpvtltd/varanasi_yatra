# =========================================================================
# VARANASI YATRA TRAVEL OS — PRODUCTION ENVIRONMENT CONFIGURATION
# =========================================================================

# APPLICATION
NODE_ENV=production
PORT=5001
API_BASE_URL=https://api.varanasiyatra.com
FRONTEND_URL=https://admin.varanasiyatra.com
ALLOWED_ORIGINS=https://admin.varanasiyatra.com,https://varanasiyatra.com

# AUTH (MUST BE SECURE 32+ CHARACTERS IN PRODUCTION)
JWT_SECRET=your_production_super_secure_jwt_access_secret_key_32chars
JWT_REFRESH_SECRET=your_production_super_secure_jwt_refresh_secret_key_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# DATABASE (MANAGED MONGODB ATLAS RECOMMENDED)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/varanasi_yatra_prod?retryWrites=true&w=majority

# AUTOMATION
AUTOMATION_ENABLED=true
NOTIFICATION_PROVIDER=ProductionProvider

# WHATSAPP (META GRAPH API)
META_WHATSAPP_ACCESS_TOKEN=EAAG...
META_WHATSAPP_PHONE_NUMBER_ID=1006543210

# EMAIL (SMTP / SENDGRID / SES)
EMAIL_PROVIDER=SMTP
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.production_sendgrid_api_key
EMAIL_FROM=support@varanasiyatra.com

# DOCUMENT STORAGE
STORAGE_PROVIDER=LocalStorageProvider
STORAGE_LOCAL_PATH=/var/app/uploads/documents

# OPTIONAL CLOUD STORAGE (S3 / GCP BUCKET)
CLOUD_STORAGE_BUCKET=varanasi-yatra-production-documents
CLOUD_STORAGE_REGION=ap-south-1
CLOUD_STORAGE_ACCESS_KEY=AKIA...
CLOUD_STORAGE_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# LOGGING
LOG_LEVEL=info
